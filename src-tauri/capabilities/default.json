{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for MarkFly",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "allow-get-pending-open-files",
    "allow-sync-file-watches",
    "allow-preview-asset",
    "allow-read-local-text-file",
    "allow-open-external-url",
    "allow-reveal-in-file-manager",
    "opener:default"
  ]
}